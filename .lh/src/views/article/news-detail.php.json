            "content": "<?php\r\nrequire_once('src/services/CommonService.php');\r\n\r\nif (isset($_GET['slug'])) {\r\n    $slug = $_GET['slug'];\r\n    $newsDetails = CommonService::newsDetails($slug);\r\n}\r\n\r\n// Check if the API response is valid\r\nif (!isset($newsDetails) || empty($newsDetails) || !isset($newsDetails['full_content'])) {\r\n    $newsError = true;\r\n} else {\r\n    $newsError = false;\r\n}\r\n?>\r\n\r\n<!DOCTYPE html>\r\n<html lang=\"reactjs\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title><?= $title ?></title>\r\n    <link href=\"<?= $favIcon ?>\" rel=\"shortcut icon\" type=\"image/png\">\r\n\r\n</head>\r\n\r\n<body>\r\n    <?php include_once('src/components/preLoader.php') ?>\r\n    <?php include_once('src/views/layouts/navbar.php') ?>\r\n\r\n    <!-- -------page header------ -->\r\n\r\n    <?php require_once('src/components/pageHeader.php'); ?>\r\n\r\n    <!-- -------page header------ -->\r\n\r\n\r\n    <!-- -------Services------ -->\r\n\r\n    <section id=\"serviceDetails\" class=\"bg-light\">\r\n        <div class=\"container-fluid services py-5\">\r\n            <div class=\"container\">\r\n                <div class=\"pb-5 wow fadeIn\" data-wow-delay=\".3s\"\r\n                    style=\"visibility: visible; animation-delay: 0.3s; animation-name: fadeIn;\">\r\n                    <div class=\"row align-items-center\">\r\n                        <div class=\"col-md-12\">\r\n                            <div class=\"card bg-white mb-4\" style=\"border:1px dashed var(--primary-color);\">\r\n                                <div class=\"card-body p-4\">\r\n                                    <article>\r\n                                        <?php if (!$newsError): ?>\r\n                                            <?= $newsDetails['full_content']; ?>\r\n                                        <?php else: ?>\r\n                                            <p class=\"text-center text-danger\">Sorry, the news details are currently\r\n                                                unavailable. Please try again later.</p>\r\n                                        <?php endif; ?>\r\n                                    </article>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n    <!-- -------Services------ -->\r\n\r\n\r\n\r\n\r\n    <?php include_once('src/views/layouts/footer.php') ?>\r\n    <script>\r\n        document.addEventListener(\"DOMContentLoaded\", function() {\r\n            let page = new URLSearchParams(window.location.search).get(\"page\") || 1;\r\n            fetchNews(parseInt(page));\r\n        });\r\n\r\n        window.addEventListener(\"popstate\", function(event) {\r\n            let page = new URLSearchParams(window.location.search).get(\"page\") || 1;\r\n            fetchNews(parseInt(page));\r\n        });\r\n    </script>\r\n    <?php\r\nfunction slugify($string) {\r\n    // Convert to lowercase\r\n    $string = strtolower($string);\r\n    \r\n    // Remove special characters\r\n    $string = preg_replace('/[^a-z0-9\\s-]/', '', $string);\r\n    \r\n    // Replace multiple spaces or dashes with a single dash\r\n    $string = preg_replace('/[\\s-]+/', '-', $string);\r\n    \r\n    // Trim leading/trailing dashes\r\n    return trim($string, '-');\r\n}\r\n\r\n// Original title\r\n$title = \"Zerodha Mutual Fund launches Zerodha Nifty 50 Index Fund\";\r\n\r\n// Generate slug\r\n$slug = slugify($title);\r\n\r\n// Output: zerodha-mutual-fund-launches-zerodha-nifty-50-index-fund\r\n?>\r\n</body>\r\n\r\n\r\n\r\n</html>"
